# Copy to .env and adjust. All values are optional - sane defaults are baked in.

PORT=4000

# Optional: a Finnhub API key (finnhub.io) gets you a higher-quality live
# quote source. Without it, the server uses Yahoo Finance's unauthenticated
# chart endpoint. Either way, if a live fetch fails (offline, rate limited,
# blocked network), a curated known-ticker list keeps the game playable via
# simulated prices.
FINNHUB_API_KEY=

# --- Tuning (mostly useful for local testing) ---
GRID_SIZE=19
ROUND_DURATION_MS=180000
SESSION_ROUNDS=40
CASTLE_BUFF_EVERY_N_ROUNDS=2
TAKEOVER_STREAK=2
SESSION_WINNER_TOKENS=3
MIN_HQ_DISTANCE=5
PRICE_TICK_MS=4000
DB_PATH=./data/gamet.sqlite
